---
const { title, description, link, date } = Astro.props;
---

<div class="w-full max-w-3xl bg-white rounded-lg shadow-md p-6 mb-6">
  <h2 class="text-xl font-bold text-primary-blue mb-2">
    {title}
  </h2>
  <p class="text-gray-500 mb-2">{date.toLocaleDateString()}</p>
  <p class="text-gray-700 mb-4">{description}</p>
  <a href={link} target="_blank" class="text-primary-blue hover:underline">
    Ler publicação
  </a>
</div>
